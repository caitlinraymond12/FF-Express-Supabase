// prisma/schema.prisma
// Each model becomes a table in your database.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // The connection string lives in prisma.config.js
}

// One row for each person who submits the form
model Person {
  id              Int                  @id @default(autoincrement())
  name            String
  age             Int                  @default(16)
  dashboardToken  String?              @unique
  createdAt       DateTime             @default(now())
  countries       PersonCountry[]
  wantedCountries PersonWantCountry[]
}

// ISO 3166-1 alpha-3 codes identify countries consistently across the app and map.
model Country {
  id       Int                  @id @default(autoincrement())
  code     String               @unique
  name     String               @unique
  people   PersonCountry[]
  wantedBy PersonWantCountry[]
}

// A person can select many countries, and each country can be selected by many people.
model PersonCountry {
  personId  Int
  countryId Int
  person    Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
  country   Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@id([personId, countryId])
  @@index([countryId])
}

model PersonWantCountry {
  personId  Int
  countryId Int
  person    Person  @relation(fields: [personId], references: [id], onDelete: Cascade)
  country   Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@id([personId, countryId])
  @@index([countryId])
}
