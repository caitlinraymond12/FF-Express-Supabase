<h1>What's your favorite color? (Relational)</h1>
<p>The colors in this dropdown come from the <strong>Color</strong> table.
  The form sends the color's <code>id</code>, not its name.</p>

<form action="/relational" method="post">
  <label for="name">Name</label>
  <input type="text" id="name" name="name" required>

  <label for="colorId">Favorite color</label>
  <select id="colorId" name="colorId" required>
    <option value="">Choose a color</option>
    {{#each colors}}
      <option value="{{this.id}}">{{this.name}}</option>
    {{/each}}
  </select>

  <button type="submit">Submit</button>
</form>

{{#unless colors.length}}
  <p>The Color table is empty. Run <code>npm run db:seed</code> to add the rainbow colors.</p>
{{/unless}}
